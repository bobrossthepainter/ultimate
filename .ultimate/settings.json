{
  "extensions": {
    "enable": ["voice-live"]
  },
  "modelFamilies": {
    "families": {
      "lead": { "model": "github-copilot/claude-opus-5.5", "thinking": "high", "color": "orange" },
      "review": { "model": "github-copilot/gpt-6.1-sol", "thinking": "high" },
      "fast": { "model": "github-copilot/gpt-6.1-sol" }
    },
    "assign": {
      "preview": "fast"
    }
  },
  "isolates": {
    "worktree": {
      "setup": ["pnpm install --frozen-lockfile --prefer-offline"]
    }
  },
  "lander": {
    "checks": [
      { "command": "pnpm check", "timeout": 120 },
      [
        { "command": "pnpm test", "timeout": 180 },
        { "command": "pnpm test:e2e", "timeout": 180 }
      ]
    ],
    "push": "origin"
  }
}
